# Copie para .env e preencha fora do chat (ver CLAUDE.md → Secrets).
PORT=3001
# Segredo dos tokens JWT. Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio = segredo aleatório a cada início do servidor (o login cai a cada reinício).
JWT_SECRET=

# --- Mercado Pago (spec 10) ---
# Todas vazias = pagamento simulado, como hoje. Preencheu uma, preencha todas: configuração pela
# metade não deixa o servidor subir (a mensagem diz o que falta).
# Credenciais da aplicação no painel do Mercado Pago (Suas integrações):
MP_APP_ID=
MP_CLIENT_SECRET=
# Endereço de retorno do OAuth, igual ao cadastrado no painel: <APP_URL>/api/mp/callback
MP_OAUTH_REDIRECT_URI=
# Assinatura secreta das notificações (Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=
# Chave que cifra os tokens dos vendedores no banco. Gere uma:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar a chave invalida as conexões já feitas (os vendedores conectam de novo).
MP_TOKEN_ENCRYPTION_KEY=
# Endereço público da API (https). Sem ele público, o Mercado Pago não entrega notificação nem volta
# sozinho ao app; o sync da volta e a varredura ainda conferem o pagamento.
APP_URL=
# 1 = PKCE no OAuth (ligue também no painel do Mercado Pago)
MP_OAUTH_PKCE=
