{
  "name": "agrotech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks')}catch{}\"",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=88 --test-coverage-branches=68 --test-coverage-functions=85",
    "lint": "eslint .",
    "lint:budget": "eslint . --max-warnings=19",
    "typecheck": "tsc -p jsconfig.json",
    "check:coherence": "node .ai/scripts/check-coherence.js",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify": "npm run lint:budget && npm run typecheck && npm run test:coverage && npm run check:coherence && node --test .ai/scripts/spec-guard.test.js .claude/hooks/workflow-guide.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
